const MAX_INPUT_BYTES = 1024 * 1024;

export function sha256(value) {
  return createHash('sha256').update(value).digest('hex');
}

export function serialize(obj) {
  return JSON.stringify(obj, Object.keys(obj).sort());
}

export function unixNano() {
  return (BigInt(Date.now()) * 1_000_000n).toString();
}

export function toBytes(input) {
  let bytes;
  if (typeof input === 'string') {
    if (input.length > MAX_INPUT_BYTES) throw new RangeError('Input exceeds limit.');
    bytes = Buffer.from(input, 'utf8');
  } else if (input instanceof ArrayBuffer) {
    bytes = new Uint8Array(input);
  } else if (ArrayBuffer.isView(input)) {
    bytes = new Uint8Array(input.buffer, input.byteOffset, input.byteLength);
  } else {
    throw new TypeError('Expected string, ArrayBuffer, or typed array.');
  }
  return Buffer.from(bytes);
}

export function sanitizeOutput(text) {
  if (typeof text !== 'string') throw new TypeError('Expected text.');
  return stripVTControlCharacters(text).replace(/[^\x09\x0A\x20-\x7E]/g, '');
}

