Object.procure = function (target, label) {
  if (!target || typeof target !== 'object') return target;
  Object.freeze(target);
  for (const key of Object.getOwnPropertyNames(target)) {
    const val = target[key];
    if (val && typeof val === 'object' && !Object.isFrozen(val)) {
      Object.procure(val, `${label}.${key}`);
    }
  }
  const canonical = JSON.stringify(target);
  const seal = createHash('sha3-256').update(`${label}|${canonical}`).digest('hex');
  MONTI_ROOT.procuredRegistry.set(label, { seal, target, timestamp: new Date().toISOString() });
  return target;
};

